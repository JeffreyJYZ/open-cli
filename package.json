{
	"name": "open-cli",
	"version": "1.0.0",
	"description": "Cross-platform project launcher for developers",
	"main": "dist/index.min.js",
	"scripts": {
		"build": "turbo run bundle",
		"bundle": "tsx src/build.ts",
		"test": "pnpm build && node scripts/test.cjs",
		"link": "pnpm link",
		"unlink": "pnpm unlink",
		"typecheck": "bun check",
		"fmt": "biome format --write .",
		"lint": "biome lint --write ."
	},
	"bin": {
		"o": "dist/index.min.js"
	},
	"keywords": [
		"cli",
		"launcher",
		"productivity",
		"open-cli"
	],
	"author": "",
	"license": "ISC",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@10.33.2",
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/node": "^25.6.0",
		"esbuild": "^0.28.0",
		"tsx": "^4.20.6",
		"turbo": "^2.5.8",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@inquirer/prompts": "^7.10.1",
		"chalk": "^5.6.2",
		"dotenv": "^17.4.2",
		"zod": "^4.3.6"
	}
}
